# Copy this file to .env for local development.
# Never commit real secrets, production credentials, tokens, or certificates.

APP_NAME=isekai-wanderer
APP_ENV=development
APP_URL=http://localhost:8081
TZ=UTC
LOG_LEVEL=info

BACKEND_PORT=8000
FRONTEND_PORT=8081
ADMIN_PORT=3100

API_BASE_URL=http://localhost:8000
ADMIN_BASE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:8081,http://localhost:3100

DATABASE_URL=postgresql+asyncpg://isekai:isekai_password@localhost:5432/isekai
POSTGRES_USER=isekai
POSTGRES_PASSWORD=isekai_password
POSTGRES_DB=isekai

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-local-only
SESSION_SECRET=change-me-local-only

# LLM API
LLM_API_KEY=test-key-placeholder
LLM_MODEL=gpt-4o-mini

# Email (163 SMTP for production, mock for dev)
# 163 邮箱: SMTP_HOST=smtp.163.com, SMTP_PORT=465 (SSL) or 587 (STARTTLS)
# 授权码在 163 邮箱设置中开启 SMTP 服务后获取
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@isekai-wanderer.local
